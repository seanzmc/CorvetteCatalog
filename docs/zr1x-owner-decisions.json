    "records": [
      {"decision_id": "ZR1X-D01", "baseline_issue": "Source-standard FEH and 3LZ N3W are inactive; CFC includes GBA is an emitted but currently unacquired rule.", "target": "Propose restoring FEH and trim-qualified N3W to configured content, with N2Z replacing N3W. Remove the unsupported CFC-to-GBA implication before promoting standard content.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Mechanical 5!A45:K45; Interior 5!A80:K80; Exterior 5!A9:K9; zr1x_options rows 64/165/188; zr1x_rule_mapping row 5; runtime foundations. A convertible must retain an otherwise valid nonblack paint.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": [{"source_sheet": "zr1x_rule_mapping", "source_row": 5, "rule_id": "zr1x_rule_cfc_includes_gba_dd934a80de02", "source_id": "opt_cfc_002", "target_id": "opt_gba_001", "target_action": "remove"}]},
      {"decision_id": "ZR1X-D02", "baseline_issue": "PCQ/VWT/R88/SLN remain selectable despite unavailable disclosures; V8X is inactive globally.", "target": "Propose applicable factory-unavailable cards that are disabled and cannot acquire charges, keeping V8X 3LZ scope. Do not confuse lifecycle with selectable compatibility conflicts.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Exterior 5!A22:K22, A28:K28, A31:K31; Mechanical 5!A36:K36; Interior 5!A42:K42; starting_choice_observations. Check no acquisition or charge in applicable unavailable contexts.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D03", "baseline_issue": "SBT adds 2720 because included SC7 contributes another 195.", "target": "Propose SBT at 2525 with included SC7 zero; independent ownership is a separate D06 decision.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Exterior 5!A34:K34; zr1x-C347 through C350. Both coupe trims and both acquisition orders should charge the package once.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D04", "baseline_issue": "Four 3LZ R6X/AE4 component paths each omit 595.", "target": "Propose restoring the missing AE4 charge only on these four paths; preserve all other interior charge ownership.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "PriceRef rows 12/14/18/20/22; zr1x-C1773/C1827/C1917/C1953. Expected interior totals 1590/2085/2485/2980, observed 995/1490/1890/2385.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D05", "baseline_issue": "DTC is absent from three graphic groups; SFZ/R88 coexist with DTC and SB9 replaces it only through section behavior.", "target": "Propose adding DTC to the three model-owned graphic groups. Use the accepted common compatibility notice/confirm/cancel policy; do not allow prohibited coexistence or enable factory-unavailable offerings.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Exterior 5!A26:K28; zr1x_rule_group_members; zr1x-C045/C046/C075/C076/C105/C106 and convertible counterparts. Both orders must enforce the disclosed exclusion.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D06", "baseline_issue": "Package acquisition absorbs independent child purchases, including TOM; ZTK removal loses independently selected TOM.", "target": "Propose preserving independent TOM/SC7/VWE/CAV/RYT ownership through packages; retain TOM at 12995 after ZTK removal only when independently acquired. Remove package-only children. Leave previously displaced covers deselected and uncharged.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "zr1x-C119 through C132, C296/C309/C322/C335, C347 through C350. Compare independent-first with package-only removal and both cover acquisition orders.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D07", "baseline_issue": "SAI is omitted; DUE says Santorini Blue instead of Royal Blue; source lists both DUW and DTC.", "target": "Propose SAI at 295 with V8X exclusion and a Royal Blue DUE name. Decide DUW independently for ZR1X: retain it provisionally alongside DTC until the owner decides; the ZR1 removal decision is not transferred.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Interior 5!A41:K41; Price Schedule!B128:E128; Exterior 5!A54:K54, A56:K56, A62:K62. SAI applies in all four configurations and cannot coexist with V8X.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1X-D08", "baseline_issue": "Rates and customer-selection scope are reconciled but not separately owner-approved for ZR1X; currency is not separately confirmed.", "target": "Request confirmation of USD and the documented model-qualified numeric/scope basis: destination once, R8E 2600, ZTK plus TOM 14495, standard J59/UQT, E60 at 3LZ only, current HP1 combined-with-LT7 copy, and the twelve external service/emissions/order-type exclusions.", "review_state": "open", "authority": "Proposed during discovery; not accepted by the owner.", "evidence_and_expected_sequence": "Price Schedule!F38:J41 and rows 50/193/199/231/238-239; Mechanical 5!A25:K25; guide_only_dispositions; foundations and zr1x-C295/C308/C321/C334. Do not import ZR1 rates or the GSX HP1 correction.", "decision_document": "zr1x-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
