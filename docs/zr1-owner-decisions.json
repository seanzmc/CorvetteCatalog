      {"decision_id": "ZR1-D06", "baseline_issue": null, "target": "Preserve independent purchase intent through packages and make replacement/removal effects explicit. Retain TOM only if selected before ZTK; remove TOM with ZTK if ZTK auto-added it.", "review_state": "accepted", "authority": "Explicit owner approvals and interaction clarifications, September 11, 2026", "evidence_and_expected_sequence": "TOM→ZTK→remove ZTK retains TOM at its standalone charge; fresh ZTK→remove ZTK removes automatic TOM and its charge. SC7/PEF/PDY/PCQ analogues retain independently acquired children. Previously displaced covers remain deselected after TOM/ZTK removal; do not restore their selections or charges automatically. The user may select a compatible cover again.", "decision_document": "zr1-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1-D07", "baseline_issue": null, "target": "Add SAI with its V8X scope; rename DUE to Royal Blue; remove DUW from the future ZR1 offering set and retain DTC.", "review_state": "accepted", "authority": "Explicit owner approvals and interaction clarifications, September 11, 2026", "evidence_and_expected_sequence": "Interior 5!41 and Exterior 5!54,56,62 remain original evidence listing DUW and DTC. DUW removal is an explicit owner correction, not a source fact. Reconcile affected relationships with retained DTC, including D05; DUW must not be selectable or charged in the future build.", "decision_document": "zr1-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
      {"decision_id": "ZR1-D08", "baseline_issue": null, "target": "Preserve ZR1-qualified base/options, R8E 3,000, ZTK+TOM 18,990 and standard UQT. Accept the documented numeric basis: base plus destination once, option schedule column E with D qualifiers, and customer-selection scope with external conditions retained as disclosures.", "review_state": "accepted", "authority": "Explicit owner approvals and interaction clarifications, September 11, 2026", "evidence_and_expected_sequence": "§§2–3,7; do not apply ZR1X ZTK rate, Z06 recorder charge or other-model paid standard equipment.", "decision_document": "zr1-behavior.md#8-open-owner-decisions-and-expected-targets", "target_rule_removals": []},
